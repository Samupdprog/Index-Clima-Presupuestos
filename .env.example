# -----------------------------------------------------------------------------
# Identidad de esta instalación
# -----------------------------------------------------------------------------
INSTANCE_SLUG=index-clima
# UUID estable de la instalación. Debe coincidir con la fila de `installations`
# que crea `db:seed`. Si se deja vacío, el seed genera/actualiza por slug.
INSTALLATION_ID=
INSTALLATION_SLUG=index-clima
INSTALLATION_NAME=Index Clima
APP_NAME=Generador de Presupuestos
LOCALE=es-ES
TZ=UTC
CURRENCY=EUR
TAX_LABEL=VAT
TAX_DEFAULT_RATE=21
TAX_ALLOWED_RATES=0,4,10,21
FEATURE_MATERIALS=true
FEATURE_LABOR=true
FEATURE_TRAVEL=true
FEATURE_SUPPLIER_DISCOUNTS=true
FEATURE_PRICE_ADJUSTMENTS=true
FEATURE_TEXT_TEMPLATES=true
# Holded se gestiona desde la UI (Configuración → Holded). Actívalo aquí.
FEATURE_HOLDED=true
FEATURE_MCP=false
FEATURE_AI_IMPORT=false

# -----------------------------------------------------------------------------
# URLs públicas
# -----------------------------------------------------------------------------
APP_HOST=presupuestos.example.com
MCP_HOST=mcp.example.com

# Red Docker del Traefik compartido del servidor.
TRAEFIK_NETWORK=app-net
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Puertos ligados SOLO a localhost.
# Permiten diagnóstico/desarrollo sin exponer servicios a Internet.
# -----------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
MCP_PORT=4001
WORKER_HEALTH_PORT=4002
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=quotes
POSTGRES_USER=quotes
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://quotes:CHANGE_ME@postgres:5432/quotes

# -----------------------------------------------------------------------------
# Comunicación interna
# -----------------------------------------------------------------------------
INTERNAL_API_URL=http://api:4000
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# Holded
# -----------------------------------------------------------------------------
# Fallback OPCIONAL. Lo normal es dejarlo vacío y pegar la clave desde la UI
# (se cifra y se guarda en installations.config.holded.apiKeyEncrypted).
HOLDED_API_KEY=
# Secret estable para cifrar la clave guardada desde Configuración (AES-256-GCM).
# En producción usa un valor propio y estable: si cambia, las claves ya
# cifradas dejan de poder descifrarse y habrá que volver a introducirlas.
# Si se deja vacío, se deriva de INTERNAL_SERVICE_TOKEN (estable por despliegue).
HOLDED_ENCRYPTION_KEY=
# Intervalo inicial de comprobación: 1, 5, 10, 15, 30 o 60 minutos.
HOLDED_HEALTH_CHECK_INTERVAL_MINUTES=5

# -----------------------------------------------------------------------------
# MCP / Auth
# En la fase de infraestructura no se habilitan herramientas mutables.
# -----------------------------------------------------------------------------
MCP_AUTH_MODE=disabled
MCP_REQUIRED_SCOPES=clients:read,clients:write,quotes:read,quotes:write,holded:read,holded:write
AUTH_ISSUER_URL=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
