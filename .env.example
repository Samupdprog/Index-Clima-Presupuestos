# =============================================================================
# Generador de Presupuestos Index Clima — configuración de la instalación
#
# Copia este archivo a `.env` (o genera uno con scripts/setup-instance.sh) y
# sustituye TODOS los CHANGE_ME. `.env` nunca se sube a Git.
# Genera secretos con:  openssl rand -hex 32
# Genera un UUID con:   cat /proc/sys/kernel/random/uuid   (o uuidgen)
# =============================================================================

# -----------------------------------------------------------------------------
# Identidad de esta instalación (obligatorio)
# -----------------------------------------------------------------------------
INSTANCE_SLUG=index-clima
# UUID estable de la instalación. `migrate` crea/actualiza la fila con este id;
# API y MCP solo operan sobre esta instalación. No lo cambies tras el primer
# despliegue.
INSTALLATION_ID=CHANGE_ME
INSTALLATION_SLUG=index-clima
INSTALLATION_NAME="Index Clima"
TZ=UTC

# Acceso web (HTTP Basic delante de toda la interfaz). Obligatorio con
# docker-compose.prod.yml: contraseña única y larga.
APP_ACCESS_USERNAME=index-clima
APP_ACCESS_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Funcionalidades
# -----------------------------------------------------------------------------
# Holded: la API key se pega en Configuración → Holded (se guarda cifrada).
FEATURE_HOLDED=true
# MCP para IA. Para desplegar el contenedor también hace falta COMPOSE_PROFILES=mcp.
FEATURE_MCP=true
# Permite al usuario (nunca a la IA) borrar datos funcionales locales. Déjalo en false.
ALLOW_DATA_RESET=false

# Perfiles de Docker Compose que se levantan con `docker compose up`.
# `mcp` añade el servidor MCP y `oauth` su Authorization Server (ChatGPT/Claude).
# Déjalo vacío para instalaciones sin IA.
COMPOSE_PROFILES=mcp,oauth

# -----------------------------------------------------------------------------
# Dominios públicos (HTTPS mediante el Traefik compartido del servidor)
# -----------------------------------------------------------------------------
APP_HOST=presupuestos.example.com
MCP_HOST=mcp.example.com
# URL exacta que configurarás en el cliente MCP (audiencia del token).
MCP_PUBLIC_URL=https://mcp.example.com/mcp
# Red Docker del Traefik compartido y email para Let's Encrypt.
TRAEFIK_NETWORK=app-net
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Puertos publicados SOLO en 127.0.0.1 (diagnóstico y desarrollo local).
# Nunca se exponen a Internet: el tráfico público entra por Traefik.
# -----------------------------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
MCP_PORT=4001
WORKER_HEALTH_PORT=4002
OAUTH_PORT=4003
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# PostgreSQL (volumen persistente `${INSTANCE_SLUG}-postgres-data`)
# -----------------------------------------------------------------------------
POSTGRES_DB=quotes
POSTGRES_USER=quotes
POSTGRES_PASSWORD=CHANGE_ME
# Dentro de Compose el host es `postgres:5432`. Repite aquí la misma contraseña.
DATABASE_URL=postgresql://quotes:CHANGE_ME@postgres:5432/quotes

# -----------------------------------------------------------------------------
# Comunicación interna entre servicios (obligatorio, >= 32 caracteres)
# -----------------------------------------------------------------------------
INTERNAL_API_URL=http://api:4000
INTERNAL_SERVICE_TOKEN=CHANGE_ME

# -----------------------------------------------------------------------------
# Holded (API v2)
# -----------------------------------------------------------------------------
# Secreto estable para cifrar la API key guardada desde Configuración
# (AES-256-GCM). Si cambia, habrá que volver a introducir la clave de Holded.
HOLDED_ENCRYPTION_KEY=CHANGE_ME
# Fallback OPCIONAL: lo normal es dejarlo vacío y pegar la clave en la web.
# Permisos necesarios: contacts:contacts.read/write, sales:estimates.read/write,
# accounting:taxes.read.
HOLDED_API_KEY=
# Intervalo de comprobación de salud: 1, 5, 10, 15, 30 o 60 minutos.
HOLDED_HEALTH_CHECK_INTERVAL_MINUTES=5
# Webhooks opcionales de contactos (requieren URL pública /api/holded-webhook).
HOLDED_WEBHOOK_SECRET=
HOLDED_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# MCP (solo si FEATURE_MCP=true)
# -----------------------------------------------------------------------------
# Autenticación del MCP:
#   oauth  -> ChatGPT/Claude con OAuth 2.1. El token estático solo vale para
#             llamadas directas dentro del contenedor (smoke tests).
#   bearer -> solo MCP_AUTH_TOKEN (clientes propios, sin OAuth).
#   hybrid -> ambos desde la red; úsalo solo temporalmente para diagnóstico.
MCP_AUTH_MODE=oauth
# Token estático: aleatorio, >= 32 caracteres y DISTINTO de INTERNAL_SERVICE_TOKEN.
# Nunca se reenvía a la API ni a Holded.
MCP_AUTH_TOKEN=CHANGE_ME
# Identidad auditada del token estático (OAuth usa oauth:<sub>).
MCP_SUBJECT=local-ai
# Scopes del token estático y TECHO de cualquier token OAuth.
# Solo lectura: quotes:read,clients:read,holded:read
MCP_SCOPES=clients:read,clients:write,quotes:read,quotes:write,holded:read,holded:write

# -----------------------------------------------------------------------------
# OAuth 2.1 (MCP_AUTH_MODE=oauth o hybrid)
# -----------------------------------------------------------------------------
# Issuer público. Vacío = origen de MCP_PUBLIC_URL (Authorization Server integrado,
# p. ej. https://mcp.example.com). Con un IdP externo, su issuer exacto.
AUTH_ISSUER_URL=
# JWKS que usa el MCP para validar tokens. Vacío = servicio integrado por la red interna.
# Con un IdP externo, su jwks_uri (HTTPS).
AUTH_JWKS_URL=
# Opcional: lista de `sub` OAuth permitidos (recomendado con IdP externos).
AUTH_ALLOWED_SUBJECTS=

# --- Authorization Server integrado (perfil `oauth`) ---
# Clave privada EC P-256 (PKCS#8 PEM en base64, una línea). Generar:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl base64 -A
# Cambiarla invalida todos los tokens emitidos (sirve para revocar accesos).
AUTH_SIGNING_KEY=CHANGE_ME
# Secreto de cookies de la sesión de autorización (>= 32 caracteres).
AUTH_COOKIE_SECRET=CHANGE_ME
# Cuenta del propietario que autoriza a ChatGPT/Claude (contraseña >= 16 caracteres).
AUTH_OWNER_USERNAME=index-clima
AUTH_OWNER_PASSWORD=CHANGE_ME
# Hosts de los que se aceptan Client ID Metadata Documents (CIMD).
AUTH_CIMD_ALLOWED_HOSTS=chatgpt.com,claude.ai,claude.com
# Redirect URIs HTTPS adicionales exactas (además de ChatGPT, Claude y loopback).
AUTH_EXTRA_REDIRECT_URIS=

# -----------------------------------------------------------------------------
# Reservado (sin efecto en esta versión; se conserva por compatibilidad)
# -----------------------------------------------------------------------------
APP_NAME="Generador de Presupuestos"
LOCALE=es-ES
CURRENCY=EUR
TAX_LABEL=IGIC
TAX_DEFAULT_RATE=7
TAX_ALLOWED_RATES=0,3,7,15
FEATURE_MATERIALS=true
FEATURE_LABOR=true
FEATURE_TRAVEL=true
FEATURE_SUPPLIER_DISCOUNTS=true
FEATURE_PRICE_ADJUSTMENTS=true
FEATURE_TEXT_TEMPLATES=true
FEATURE_AI_IMPORT=false
