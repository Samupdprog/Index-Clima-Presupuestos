{
  "name": "@quotes/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:mi": "npm run db:migrate",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@quotes/domain": "0.1.0",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "typescript": "^6.0.0"
  }
}
