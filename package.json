{
  "name": "generador-de-presupuestos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace @quotes/web",
    "dev:api": "npm run dev --workspace @quotes/api",
    "dev:mcp": "npm run dev --workspace @quotes/mcp",
    "dev:worker": "npm run dev --workspace @quotes/worker",
    "dev:local:api": "node scripts/dev-local.mjs api",
    "dev:local:web": "node scripts/dev-local.mjs web",
    "dev:local:mcp": "node scripts/dev-local.mjs mcp",
    "dev:local:worker": "node scripts/dev-local.mjs worker",
    "dev:local:oauth": "node scripts/dev-local.mjs oauth",
    "infra:up": "docker compose up -d postgres",
    "infra:down": "docker compose down",
    "db:generate": "npm run db:generate --workspace @quotes/db",
    "db:mi": "npm run db:migrate --workspace @quotes/db",
    "db:migrate": "npm run db:migrate --workspace @quotes/db",
    "db:seed": "npm run db:seed --workspace @quotes/db",
    "db:reset:dev": "node scripts/dev-reset.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "vitest run packages/db/integration",
    "test:security": "vitest run tests/security",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:holded-live": "node scripts/run-holded-live.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.9"
    }
  }
}
